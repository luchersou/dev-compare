# Optional. GitHub personal access token (no scopes needed) used for the
# repository stats. Without it the GitHub API allows 60 requests/hour per IP.
GITHUB_TOKEN=

# Optional. Public URL used for canonical links, Open Graph images, the
# sitemap and robots.txt. Defaults to the live demo.
NEXT_PUBLIC_SITE_URL=https://npm-comparator-ten.vercel.app
